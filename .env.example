# =============================================================================
# Copia este archivo a .env y cambia los valores.
#   cp .env.example .env        (Git Bash / Linux / Mac)
#   copy .env.example .env      (Windows, consola)
# .env NUNCA se sube al repositorio.
# =============================================================================

# --- Base de datos ----------------------------------------------------------
# Opcion A: Postgres local instalado en tu computador
#   DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/ccv?schema=public"
# Opcion B: una base gratuita en la nube (recomendado para empezar)
#   Supabase, Neon o Railway te dan esta cadena tal cual.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/ccv?schema=public"

# --- Servidor ---------------------------------------------------------------
NODE_ENV="development"
PORT=3000
# Origenes permitidos separados por coma. Sin esto el navegador bloquea.
CORS_ORIGINS="http://localhost:5173"

# --- Sesion (cookie httpOnly) -----------------------------------------------
# Firma las cookies. Genera uno con el comando que aparece en el README.
SESSION_SECRET="CAMBIAME-por-un-valor-aleatorio-largo"
# "secure": false en desarrollo (porque es http://localhost).
# Ponlo en true cuando sis en https.
SESSION_COOKIE_SECURE="false"
SESSION_MAX_AGE_MINUTOS="120"

# --- Primer administrador (lo usa scripts/crear-admin.js) ------------------
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="CAMBIAME-por-una-contrasena-larga"

# --- Correo -----------------------------------------------------------------
# La Etapa 1 usa el proveedor de prueba, que escribe el mensaje en la consola.
# MAIL_DRIVER=consola  -> imprime el correo en la terminal
# MAIL_DRIVER=ninguno  -> no envia nada
MAIL_DRIVER="consola"
# Dejalo vacio hasta que elijas proveedor (Resend, Postmark o SES).
MAIL_FROM="no-reply@tudominio.co"
MAIL_PROVEEDOR_API_KEY=""
# --- PostgreSQL local (instalado sin permisos de administrador) ---
PGBIN="C:/Users/anturi/pgsql/pgsql/bin"
PGDATA="C:/Users/anturi/pgdata"
