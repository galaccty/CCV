// Esquema Prisma - Etapa 1
//
// Regla del proyecto: los nombres de tablas y columnas en la base de datos
// son exactamente los de la especificacion V4, en snake_case. Prisma los usa
// solo como cliente; las migraciones SQL reales viven en prisma/migrations/.
//
// Si agregas una tabla o columna, NO edites una migracion ya aplicada.
// Agrega la migracion nueva con:
//   npx prisma migrate dev --name <nombre>
// y despues revisa el SQL en prisma/migrations/<nombre>/migration.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 4.1 usuario
// ---------------------------------------------------------------------------

model Usuario {
  id              Int      @id @default(autoincrement())
  nombre          String   @db.VarChar(120)
  email           String   @unique @db.VarChar(255)
  telefono        String?  @db.VarChar(30)
  emailVerificado Boolean  @default(false) @map("email_verificado")
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  // Version de la cookie de sesion. Cambiar la contrasena la incrementa para
  // invalidar todas las sesiones anteriores; la sesion actual recibe una
  // cookie nueva con la version nueva.
  versionSesion   Int      @default(0) @map("version_sesion")
  aceptoTerminos  Boolean  @map("acepto_terminos")
  fechaAceptacion DateTime @map("fecha_aceptacion") @db.Timestamptz(3)
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn   DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  roles                 UsuarioRol[]
  tokens                TokenVerificacion[]
  auditoria             AuditoriaAdmin[]
  locales               Local[]
  pedidos               Pedido[]
  idempotencias         Idempotencia[]
  historialSubPedido    HistorialEstadoSubPedido[]
  carrito               Carrito?
  direcciones           Direccion[]
  pagosDeudaReportados  PagoDeuda[]                @relation("PagoDeudaReportado")
  pagosDeudaConfirmados PagoDeuda[]                @relation("PagoDeudaConfirmado")
  disputasComprador     Disputa[]                  @relation("DisputaComprador")
  disputasResueltas     Disputa[]                  @relation("DisputaResuelta")
  evidenciasDisputa     DisputaEvidencia[]
  reembolsosRegistrados Reembolso[]               @relation("ReembolsoRegistrado")

  @@map("usuario")
}

/// una persona puede ser comprador y vendedor al mismo tiempo (multi-rol)
model UsuarioRol {
  usuarioId Int      @map("usuario_id")
  rol       Rol
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rol])
  @@index([rol])
  @@map("usuario_rol")
}

enum Rol {
  comprador
  vendedor
  admin

  @@map("rol")
}

// ---------------------------------------------------------------------------
// 4.2 token_verificacion
// ---------------------------------------------------------------------------

model TokenVerificacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tipo      TipoToken
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expira    DateTime  @db.Timestamptz(3)
  usado     Boolean   @default(false)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@index([expira])
  @@map("token_verificacion")
}

enum TipoToken {
  verificar_email
  reset_password

  @@map("tipo_token")
}

// ---------------------------------------------------------------------------
// 4.13 configuracion  (clave-valor administrada por el admin)
// ---------------------------------------------------------------------------

model Configuracion {
  clave         String    @id @db.VarChar(80)
  valor         String    @db.Text
  tipo          TipoValor
  descripcion   String?   @db.VarChar(300)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@map("configuracion")
}

enum TipoValor {
  entero
  numero
  texto
  booleano

  @@map("tipo_valor")
}

// ---------------------------------------------------------------------------
// 4.10 auditoria_admin
// ---------------------------------------------------------------------------

model AuditoriaAdmin {
  id       Int         @id @default(autoincrement())
  origen   OrigenAdmin
  adminId  Int?        @map("admin_id")
  accion   String      @db.VarChar(80)
  objeto   String      @db.VarChar(80)
  objetoId String?     @map("objeto_id") @db.VarChar(80)
  detalle  Json?
  fecha    DateTime    @default(now()) @db.Timestamptz(3)

  admin Usuario? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([objeto, objetoId])
  @@index([fecha])
  @@map("auditoria_admin")
}

enum OrigenAdmin {
  admin
  sistema

  @@map("origen_admin")
}

// ===========================================================================
// ETAPA 2 - CORTE VERTICAL
// ===========================================================================
// Estas tablas se agregan en una migracion NUEVA. La migracion de la Etapa 1
// no se toca nunca.
//
// Criterio de dinero: todos los montos son enteros en pesos. Wompi trabaja en
// centavos, asi que la conversion (x100) se hace solo en el borde con Wompi.
// ===========================================================================

// ---------------------------------------------------------------------------
// Rubro y categorias (la base que necesitan local y producto)
// ---------------------------------------------------------------------------

model Rubro {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(120)

  locales    Local[]
  categorias CategoriaGlobal[]

  @@map("rubro")
}

model Local {
  id                     Int          @id @default(autoincrement())
  usuarioId              Int          @map("usuario_id")
  rubroId                Int          @map("rubro_id")
  nombre                 String       @db.VarChar(160)
  logoUrl                String?      @map("logo_url") @db.Text
  bannerFondoUrl         String?      @map("banner_fondo_url") @db.Text
  latitud                Float
  longitud               Float
  estado                 EstadoLocal  @default(pendiente_aprobacion)
  // Estado que tenia el local cuando el admin lo suspendio. Al reactivarlo,
  // recalcular_estado_local() usa este dato para no perdonar una deuda que ya
  // habia llevado al local a bloqueado/en_plazo.
  estadoPrevioSuspension EstadoLocal? @map("estado_previo_suspension")
  promedioCalificacion   Float        @default(0) @map("promedio_calificacion")
  totalCalificaciones    Int          @default(0) @map("total_calificaciones")
  creadoEn               DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  rubro         Rubro               @relation(fields: [rubroId], references: [id])
  productos     Producto[]
  subcategorias SubcategoriaLocal[]
  subPedidos    SubPedido[]
  cuenta        CuentaLocal?
  movimientos   Ledger[]
  pagosDeuda    PagoDeuda[]

  @@index([usuarioId])
  @@index([rubroId])
  @@index([estado])
  @@index([estado, rubroId])
  @@map("local")
}

model CategoriaGlobal {
  id      Int    @id @default(autoincrement())
  nombre  String @db.VarChar(120)
  padreId Int?   @map("padre_id")
  rubroId Int?   @map("rubro_id")

  padre     CategoriaGlobal?  @relation("CategoriaPadre", fields: [padreId], references: [id])
  hijos     CategoriaGlobal[] @relation("CategoriaPadre")
  rubro     Rubro?            @relation(fields: [rubroId], references: [id])
  productos Producto[]

  @@index([padreId])
  @@index([rubroId])
  @@map("categoria_global")
}

model SubcategoriaLocal {
  id      Int    @id @default(autoincrement())
  localId Int    @map("local_id")
  nombre  String @db.VarChar(120)

  local     Local      @relation(fields: [localId], references: [id])
  productos Producto[]

  @@unique([localId, nombre])
  @@map("subcategoria_local")
}

// ---------------------------------------------------------------------------
// Carrito multi-local
// ---------------------------------------------------------------------------

model Carrito {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @unique @map("usuario_id")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@map("carrito")
}

model CarritoItem {
  id            Int      @id @default(autoincrement())
  carritoId     Int      @map("carrito_id")
  varianteId    Int      @map("variante_id")
  cantidad      Int
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  carrito  Carrito          @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  variante ProductoVariante @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([carritoId, varianteId])
  @@index([varianteId])
  @@map("carrito_item")
}

// ---------------------------------------------------------------------------
// Direcciones del comprador
// ---------------------------------------------------------------------------

model Direccion {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  texto         String   @db.Text
  latitud       Float
  longitud      Float
  principal     Boolean  @default(false)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("direccion")
}

// ---------------------------------------------------------------------------
// Catalogo
// ---------------------------------------------------------------------------

model Producto {
  id                  Int      @id @default(autoincrement())
  localId             Int      @map("local_id")
  categoriaGlobalId   Int      @map("categoria_global_id")
  subcategoriaLocalId Int?     @map("subcategoria_local_id")
  nombre              String   @db.VarChar(200)
  descripcion         String?  @db.Text
  fotos               Json?
  atributos           Json?
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn       DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  local             Local              @relation(fields: [localId], references: [id])
  categoriaGlobal   CategoriaGlobal    @relation(fields: [categoriaGlobalId], references: [id])
  subcategoriaLocal SubcategoriaLocal? @relation(fields: [subcategoriaLocalId], references: [id])
  variantes         ProductoVariante[]

  @@index([localId, activo])
  @@index([categoriaGlobalId])
  @@index([localId, activo, categoriaGlobalId])
  @@map("producto")
}

model ProductoVariante {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  atributos     Json?
  precio        BigInt
  stock         Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  producto     Producto          @relation(fields: [productoId], references: [id])
  detalles     DetalleProducto[]
  carritoItems CarritoItem[]

  @@index([productoId, activo])
  @@map("producto_variante")
}

// ---------------------------------------------------------------------------
// Pedido y sub-pedidos
// ---------------------------------------------------------------------------

model Pedido {
  id                Int          @id @default(autoincrement())
  usuarioId         Int          @map("usuario_id")
  direccionTexto    String       @map("direccion_texto") @db.Text
  direccionLatitud  Float        @map("direccion_latitud")
  direccionLongitud Float        @map("direccion_longitud")
  total             BigInt
  metodoPago        MetodoPago   @map("metodo_pago")
  estado            EstadoPedido @default(pendiente_pago)
  configSnapshot    Json         @map("config_snapshot")
  creadoEn          DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id])
  subPedidos SubPedido[]
  pagos      Pago[]

  @@index([usuarioId, creadoEn])
  @@index([estado])
  @@map("pedido")
}

model SubPedido {
  id                   Int                   @id @default(autoincrement())
  pedidoId             Int                   @map("pedido_id")
  localId              Int                   @map("local_id")
  nombreLocal          String                @map("nombre_local") @db.VarChar(160)
  subtotalProductos    BigInt                @map("subtotal_productos")
  costoEnvio           BigInt                @map("costo_envio")
  comision             BigInt
  total                BigInt
  estado               EstadoSubPedido       @default(por_aceptar)
  evidenciaEnvio       String?               @map("evidencia_envio") @db.Text
  entregaConfirmadaPor EntregaConfirmadaPor? @map("entrega_confirmada_por")
  fechaEntrega         DateTime?             @map("fecha_entrega") @db.Timestamptz(3)
  saldoLiberadoEn      DateTime?             @map("saldo_liberado_en") @db.Timestamptz(3)
  notasEntrega         String?               @map("notas_entrega") @db.Text
  creadoEn             DateTime              @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime              @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  pedido      Pedido                     @relation(fields: [pedidoId], references: [id])
  local       Local                      @relation(fields: [localId], references: [id])
  detalles    DetalleProducto[]
  historial   HistorialEstadoSubPedido[]
  movimientos Ledger[]
  reembolsos  Reembolso[]
  disputa     Disputa?

  @@index([pedidoId])
  @@index([localId, estado])
  @@map("sub_pedido")
}

model DetalleProducto {
  id                Int    @id @default(autoincrement())
  subPedidoId       Int    @map("sub_pedido_id")
  varianteId        Int    @map("variante_id")
  nombreProducto    String @map("nombre_producto") @db.VarChar(200)
  atributosElegidos Json?  @map("atributos_elegidos")
  cantidad          Int
  precioUnitario    BigInt @map("precio_unitario")

  subPedido       SubPedido        @relation(fields: [subPedidoId], references: [id])
  variante        ProductoVariante @relation(fields: [varianteId], references: [id])
  lineasReembolso ReembolsoLinea[]

  @@unique([subPedidoId, varianteId])
  @@index([varianteId])
  @@map("detalle_producto")
}

model HistorialEstadoSubPedido {
  id             Int              @id @default(autoincrement())
  subPedidoId    Int              @map("sub_pedido_id")
  estadoAnterior EstadoSubPedido? @map("estado_anterior")
  estadoNuevo    EstadoSubPedido  @map("estado_nuevo")
  cambiadoPor    Int?             @map("cambiado_por")
  fecha          DateTime         @default(now()) @db.Timestamptz(3)

  subPedido SubPedido @relation(fields: [subPedidoId], references: [id])
  usuario   Usuario?  @relation(fields: [cambiadoPor], references: [id], onDelete: SetNull)

  @@index([subPedidoId, fecha])
  @@map("historial_estado_sub_pedido")
}

// ---------------------------------------------------------------------------
// Pagos, webhooks e idempotencia
// ---------------------------------------------------------------------------

model Pago {
  id                 Int        @id @default(autoincrement())
  tipoPago           TipoPago   @default(pedido) @map("tipo_pago")
  pedidoId           Int?       @map("pedido_id")
  referencia         String     @unique @db.VarChar(255)
  idTransaccionWompi String?    @unique @map("id_transaccion_wompi") @db.VarChar(120)
  metodoPago         MetodoPago @map("metodo_pago")
  monto              BigInt
  montoReembolsado   BigInt     @default(0) @map("monto_reembolsado")
  estado             EstadoPago @default(pendiente)
  fechaCreacion      DateTime   @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  fechaActualizacion DateTime   @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)

  pedido      Pedido?     @relation(fields: [pedidoId], references: [id])
  reembolsos  Reembolso[]
  movimientos Ledger[]

  // Un pedido tiene exactamente un pago. Postgres permite varios NULL en un
  // indice UNIQUE, asi que los pagos de publicidad (pedido_id NULL) no chocan.
  @@unique([pedidoId])
  @@index([estado])
  @@map("pago")
}

model EventoWebhook {
  id         Int               @id @default(autoincrement())
  referencia String?           @db.VarChar(255)
  payload    Json
  procesado  Boolean           @default(false)
  resultado  ResultadoWebhook?
  fecha      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([referencia])
  @@index([fecha])
  @@map("evento_webhook")
}

model Idempotencia {
  id            Int                @id @default(autoincrement())
  clave         String             @db.VarChar(255)
  usuarioId     Int                @map("usuario_id")
  ruta          String             @db.VarChar(255)
  estado        EstadoIdempotencia @default(en_proceso)
  codigoHttp    Int?               @map("codigo_http")
  respuestaJson Json?              @map("respuesta_json")
  fecha         DateTime           @default(now()) @db.Timestamptz(3)
  expira        DateTime           @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, ruta, clave])
  @@index([expira])
  @@map("idempotencia")
}

// ---------------------------------------------------------------------------
// Reembolsos (minimo necesario para el camino B de 4.1.4)
// ---------------------------------------------------------------------------
// La tabla completa con disputas y reembolsos por linea llega en la Etapa 4.
// Esta version alcanza para crear el reembolso total automatico cuando falla
// el stock, que es lo que exige la Etapa 2.

model Reembolso {
  id             Int             @id @default(autoincrement())
  pagoId         Int             @map("pago_id")
  subPedidoId    Int             @map("sub_pedido_id")
  disputaId      Int?            @unique @map("disputa_id")
  tipo           TipoReembolso   @default(digital)
  monto          BigInt
  montoEnvio     BigInt          @default(0) @map("monto_envio")
  incluyeEnvio   Boolean         @default(false) @map("incluye_envio")
  desdeCongelado Boolean         @default(false) @map("desde_congelado")
  estado         EstadoReembolso @default(pendiente)
  motivo         String          @db.VarChar(200)
  fechaLimite    DateTime?       @map("fecha_limite") @db.Timestamptz(3)
  registradoPor  Int?            @map("registrado_por")
  completadoEn   DateTime?       @map("completado_en") @db.Timestamptz(3)
  fecha          DateTime        @default(now()) @db.Timestamptz(3)
  actualizadoEn  DateTime        @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  pago         Pago              @relation(fields: [pagoId], references: [id])
  subPedido    SubPedido         @relation(fields: [subPedidoId], references: [id])
  disputa      Disputa?          @relation(fields: [disputaId], references: [id], onDelete: Restrict)
  registrador  Usuario?          @relation("ReembolsoRegistrado", fields: [registradoPor], references: [id], onDelete: Restrict)
  lineas       ReembolsoLinea[]
  movimientos  Ledger[]

  @@index([pagoId])
  @@index([subPedidoId])
  @@index([estado])
  @@index([registradoPor])
  @@map("reembolso")
}

model ReembolsoLinea {
  id          Int    @id @default(autoincrement())
  reembolsoId Int    @map("reembolso_id")
  detalleId   Int    @map("detalle_id")
  cantidad    Int
  monto       BigInt

  reembolso Reembolso       @relation(fields: [reembolsoId], references: [id], onDelete: Restrict)
  detalle   DetalleProducto @relation(fields: [detalleId], references: [id], onDelete: Restrict)

  @@unique([reembolsoId, detalleId])
  @@index([detalleId])
  @@map("reembolso_linea")
}

// ---------------------------------------------------------------------------
// Disputas y evidencia (Etapa 4c-1)
// ---------------------------------------------------------------------------

model Disputa {
  id                      Int             @id @default(autoincrement())
  subPedidoId             Int             @unique @map("sub_pedido_id")
  usuarioId               Int             @map("usuario_id")
  tipo                    TipoDisputa
  motivo                  String          @db.Text
  estado                  EstadoDisputa   @default(abierta)
  montoReclamado          BigInt          @map("monto_reclamado")
  montoCongelado          BigInt          @default(0) @map("monto_congelado")
  fechaApertura           DateTime        @default(now()) @map("fecha_apertura") @db.Timestamptz(3)
  fechaResolucion         DateTime?       @map("fecha_resolucion") @db.Timestamptz(3)
  resueltoPor             Int?            @map("resuelto_por")
  resolucion              String?         @db.Text
  estadoSubPedidoAnterior EstadoSubPedido @map("estado_sub_pedido_anterior")

  subPedido   SubPedido          @relation(fields: [subPedidoId], references: [id], onDelete: Restrict)
  usuario     Usuario            @relation("DisputaComprador", fields: [usuarioId], references: [id], onDelete: Restrict)
  resuelto    Usuario?           @relation("DisputaResuelta", fields: [resueltoPor], references: [id], onDelete: Restrict)
  evidencias  DisputaEvidencia[]
  reembolso   Reembolso?
  movimientos Ledger[]

  @@index([usuarioId])
  @@index([estado, fechaApertura])
  @@map("disputa")
}

model DisputaEvidencia {
  id        Int           @id @default(autoincrement())
  disputaId Int           @map("disputa_id")
  usuarioId Int           @map("usuario_id")
  lado      LadoEvidencia
  tipo      TipoEvidencia
  contenido String        @db.Text
  creadoEn  DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)

  disputa Disputa @relation(fields: [disputaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([disputaId, creadoEn])
  @@index([usuarioId])
  @@map("disputa_evidencia")
}

// ---------------------------------------------------------------------------
// Ledger y cuenta del local
// ---------------------------------------------------------------------------

model Ledger {
  id          Int            @id @default(autoincrement())
  localId     Int?           @map("local_id")
  subPedidoId Int?           @map("sub_pedido_id")
  pagoId      Int?           @map("pago_id")
  reembolsoId Int?           @map("reembolso_id")
  pagoDeudaId Int?           @map("pago_deuda_id")
  disputaId   Int?           @map("disputa_id")
  tipo        TipoMovimiento @map("tipo")
  monto       BigInt
  fecha       DateTime       @default(now()) @db.Timestamptz(3)

  local     Local?     @relation(fields: [localId], references: [id], onDelete: Restrict)
  subPedido SubPedido? @relation(fields: [subPedidoId], references: [id], onDelete: Restrict)
  pago      Pago?      @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  reembolso Reembolso? @relation(fields: [reembolsoId], references: [id], onDelete: Restrict)
  pagoDeuda PagoDeuda? @relation(fields: [pagoDeudaId], references: [id], onDelete: Restrict)
  disputa   Disputa?   @relation(fields: [disputaId], references: [id], onDelete: Restrict)

  // liquidacion_id llega en la Etapa 4, cuando exista la tabla liquidacion.
  @@index([localId, fecha])
  @@index([pagoId])
  @@index([subPedidoId])
  @@index([reembolsoId])
  @@index([pagoDeudaId])
  @@index([disputaId])
  @@map("ledger")
}

// ---------------------------------------------------------------------------
// Pago de la deuda de comision (Etapa 4b)
// ---------------------------------------------------------------------------

model PagoDeuda {
  id                Int             @id @default(autoincrement())
  localId           Int             @map("local_id")
  monto             BigInt
  metodo            MetodoPagoDeuda
  referencia        String          @unique @db.VarChar(255)
  comprobanteUrl    String?         @map("comprobante_url") @db.Text
  estado            EstadoPagoDeuda @default(pendiente)
  reportadoPor      Int?            @map("reportado_por")
  confirmadoPor     Int?            @map("confirmado_por")
  fechaReporte      DateTime        @default(now()) @map("fecha_reporte") @db.Timestamptz(3)
  fechaConfirmacion DateTime?       @map("fecha_confirmacion") @db.Timestamptz(3)
  motivoRechazo     String?         @map("motivo_rechazo") @db.Text

  local       Local    @relation(fields: [localId], references: [id], onDelete: Restrict)
  reportador  Usuario? @relation("PagoDeudaReportado", fields: [reportadoPor], references: [id], onDelete: Restrict)
  confirmador Usuario? @relation("PagoDeudaConfirmado", fields: [confirmadoPor], references: [id], onDelete: Restrict)
  movimientos Ledger[]

  @@index([localId, fechaReporte])
  @@index([estado])
  @@index([reportadoPor])
  @@index([confirmadoPor])
  @@map("pago_deuda")
}

model CuentaLocal {
  localId         Int       @id @map("local_id")
  saldoDeuda      BigInt    @default(0) @map("saldo_deuda")
  saldoPorPagar   BigInt    @default(0) @map("saldo_por_pagar")
  saldoCongelado  BigInt    @default(0) @map("saldo_congelado")
  fechaLimitePago DateTime? @map("fecha_limite_pago") @db.Date
  actualizadoEn   DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  local Local @relation(fields: [localId], references: [id])

  @@map("cuenta_local")
}

