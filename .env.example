# =============================================================================
# Copia este archivo a .env y cambia los valores.
#   cp .env.example .env        (Git Bash / Linux / Mac)
#   copy .env.example .env      (Windows, consola)
# .env NUNCA se sube al repositorio.
# =============================================================================

# --- Base de datos ----------------------------------------------------------
# Opcion A: Postgres local instalado en tu computador
#   DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/ccv?schema=public"
# Opcion B: una base gratuita en la nube (recomendado para empezar)
#   Supabase, Neon o Railway te dan esta cadena tal cual.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/ccv?schema=public"

# --- Servidor ---------------------------------------------------------------
NODE_ENV="development"
PORT=3000
# Origenes permitidos separados por coma. Sin esto el navegador bloquea.
# Usa la URL exacta del frontend; no pongas "*" porque la API envia cookies
# con credenciales. En desarrollo: http://localhost:5173
CORS_ORIGINS="http://localhost:5173"

# --- Sesion (cookie httpOnly) -----------------------------------------------
# Firma las cookies. Genera uno con el comando que aparece en el README.
SESSION_SECRET="CAMBIAME-por-un-valor-aleatorio-largo"
# "secure": false en desarrollo (porque es http://localhost).
# Ponlo en true cuando sis en https.
SESSION_COOKIE_SECURE="false"
SESSION_MAX_AGE_MINUTOS="120"

# --- Cifrado de datos bancarios (AES-256-GCM) -------------------------------
# 32 bytes aleatorios en base64. Cifra el numero de cuenta y el documento del
# titular antes de guardarlos. NO cambies ni pierdas esta clave sin volver a
# cifrar los datos existentes: sin ella no se pueden descifrar.
# Generala con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# El valor de abajo es solo un ejemplo valido para desarrollo.
CUENTA_BANCARIA_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Identificador de la version de la clave. Se guarda dentro de cada valor
# cifrado. Debe coincidir con la clave activa; cambiarlo sin rotar los datos
# existentes los vuelve ilegibles. Dejalo en 1 hasta implementar la rotacion.
CUENTA_BANCARIA_KEY_VERSION="1"

# --- Primer administrador (lo usa scripts/crear-admin.js) ------------------
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="CAMBIAME-por-una-contrasena-larga"

# --- Correo -----------------------------------------------------------------
# La Etapa 1 usa el proveedor de prueba, que escribe el mensaje en la consola.
# MAIL_DRIVER=consola  -> imprime el correo en la terminal
# MAIL_DRIVER=ninguno  -> no envia nada
MAIL_DRIVER="consola"
# Dejalo vacio hasta que elijas proveedor (Resend, Postmark o SES).
MAIL_FROM="no-reply@tudominio.co"
MAIL_PROVEEDOR_API_KEY=""

# --- Wompi ------------------------------------------------------------------
# Mientras no tengas llaves de sandbox, deja WOMPI_PROVEEDOR="falso".
# El proveedor falso NO hace llamadas HTTP: genera la firma y guarda las
# transacciones en memoria para las pruebas.
# Cuando tengas las llaves, cambia a "real" y completa las cuatro.
#   Sandbox:    pub_test_...  prv_test_...  test_events_...  test_integrity_...
#   Produccion: pub_prod_...  prv_prod_...  prod_events_...  prod_integrity_...
WOMPI_PROVEEDOR="falso"
WOMPI_PUB_KEY=""
WOMPI_PRV_KEY=""
WOMPI_EVENTS_KEY=""
WOMPI_INTEGRITY_KEY=""
WOMPI_API_BASE="https://sandbox.wompi.co/v1"
WOMPI_CHECKOUT_BASE="https://checkout.wompi.co/p/"
# Opcional: a donde vuelve el comprador despues de pagar.
WOMPI_REDIRECT_URL=""

# --- PostgreSQL local (instalado sin permisos de administrador) ---
PGBIN="C:/Users/anturi/pgsql/pgsql/bin"
PGDATA="C:/Users/anturi/pgdata"
# Log FUERA de la carpeta de datos: leerlo dentro bloquea al servidor en Windows.
PGLOG="C:/Users/anturi/pgdata-server.log"

# --- Pruebas ----------------------------------------------------------------
# Las pruebas que necesitan base FALLAN si no la encuentran. Esta variable las
# salta a proposito, solo para correr las que no necesitan base. Se ignora en CI.
# PERMITIR_SALTAR_BD="1"
